# =============================================================================
# Sentiment MLOps — Environment Configuration
# Copy this file to `.env` to override default local development settings:
#   cp .env.example .env
# =============================================================================

# Admin token required for protected Control Center actions
# (promoting models, reviewing human feedback, triggering retraining/drift runs)
ADMIN_TOKEN=dev-admin-token

# PostgreSQL credentials (used by `app` and `mlflow` databases)
POSTGRES_PASSWORD=mlops-dev-password

# Grafana admin password (default login: admin / admin)
GRAFANA_PASSWORD=admin

# Scheduled Evidently data drift check interval in minutes (set to 0 to disable)
DRIFT_INTERVAL_MIN=15
