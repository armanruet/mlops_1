  "cards": [
    {
      "dot": "cyan",
      "title": "Data & CI/CD Toolchain",
      "items": [
        "Astral uv guarantees reproducible sub-second Python dependency resolution",
        "GitHub Actions runs ruff, pytest, dvc dag validation, and docker builds",
        "DVC locks stage dependencies, code, and data hashes in dvc.lock"
      ]
    },
    {
      "dot": "emerald",
      "title": "Model Training & Registry Toolchain",
      "items": [
        "Scikit-learn fits TF-IDF n-grams with L2-regularized Logistic Regression",
        "Pure-function quality gates enforce absolute F1 thresholds and regression caps",
        "MLflow tracks experiment runs and promotes candidates via the champion alias"
      ]
    },
    {
      "dot": "rose",
      "title": "Serving & Telemetry Toolchain",
      "items": [
        "Docker Compose manages the 7-container multi-network environment",
        "FastAPI provides sub-second inference and zero-downtime hot reload",
        "Next.js, PostgreSQL, Prometheus, and Evidently AI close the feedback loop"
      ]
    }
